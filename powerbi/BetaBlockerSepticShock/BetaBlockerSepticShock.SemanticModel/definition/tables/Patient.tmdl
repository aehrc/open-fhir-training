		isHidden
		summarizeBy: none
		sourceColumn: discharge_time

	column suspected_infection_time
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn
		isHidden
		summarizeBy: none
		sourceColumn: suspected_infection_time

	column sepsis_time
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn
		isHidden
		summarizeBy: none
		sourceColumn: sepsis_time

	column baseline_time
