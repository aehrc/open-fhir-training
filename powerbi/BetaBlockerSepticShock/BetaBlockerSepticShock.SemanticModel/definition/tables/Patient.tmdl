table Patient

	measure Patients = COUNTROWS(Patient)
		formatString: #,0

	measure 'Patients remaining' = ```
			VAR s = SELECTEDVALUE('Cohort step'[Order])
			RETURN COUNTROWS(FILTER(Patient,
			    (s < 2 || Patient[adult])
			        && (s < 3 || Patient[stay_48_hours])
			        && (s < 4 || NOT ISBLANK(Patient[suspected_infection_time]))
			        && (s < 5 || NOT ISBLANK(Patient[sepsis_time]))
			        && (s < 6 || NOT ISBLANK(Patient[baseline_time]))
			        && (s < 7 || NOT (Patient[av_block] || Patient[acute_mi] || Patient[acute_heart_failure] || Patient[asthma]))))
			```
		formatString: #,0

	measure 'Deaths within 28 days' = CALCULATE([Patients], Patient[Died within 28 days] = "Yes")
		formatString: #,0

	measure '28-day mortality' = DIVIDE([Deaths within 28 days], [Patients])
		formatString: 0%

	measure 'Zhang et al. (2024)' = DIVIDE(SELECTEDVALUE('Treatment group'[Published percent]), 100)
		formatString: 0.0%

	measure '% alive' = ```
			VAR d = MAX(Day[Days since baseline])
			RETURN 1 - DIVIDE(COUNTROWS(FILTER(Patient, NOT ISBLANK(Patient[Days to death]) && Patient[Days to death] <= d)), [Patients])
			```
		formatString: 0%

	measure 'Patients with contraindication' = DISTINCTCOUNT(Contraindication[patient_id])
		formatString: #,0

	column patient_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: patient_id

	column Patient
		dataType: string
		summarizeBy: none
		sourceColumn: Patient

	column stay_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: stay_id

	column Gender
		dataType: string
		summarizeBy: none
		sourceColumn: gender

	column Age
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: age

	column 'ICU hours'
		dataType: double
		formatString: 0
		summarizeBy: none
		sourceColumn: icu_hours

	column SOFA
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: sofa

	column 'Treatment group'
		dataType: string
		summarizeBy: none
		sourceColumn: Treatment group

	column 'Days to death'
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: Days to death

	column 'Hours to first beta-blocker'
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: Hours to first beta-blocker

	column 'Died within 28 days'
		dataType: string
		summarizeBy: none
		sourceColumn: Died within 28 days

	column admit_time
