		isHidden
		summarizeBy: none
		sourceColumn: acute_mi

	column acute_heart_failure
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: acute_heart_failure

	column asthma
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: asthma

	column in_cohort
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: in_cohort

	column beta_blocker
