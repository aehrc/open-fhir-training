	column stay_48_hours
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: stay_48_hours

	column av_block
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: av_block

	column acute_mi
