		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: sofa_renal

	partition Patient = m
		mode: import
		source =
				let
				    Source = DatabricksMultiCloud.Catalogs(DatabricksHost, DatabricksHttpPath, [Catalog = null, Database = null, EnableAutomaticProxyDiscovery = null]),
				    Catalog = Source{[Name = "hive_metastore"]}[Data],
				    Schema = Catalog{[Name = "mimic_iv_beta_blocker_views"]}[Data],
				    Data = Schema{[Name = "beta_blocker_septic_shock"]}[Data],
				    Typed = Table.TransformColumnTypes(Data, {{"admit_time", type datetime}, {"discharge_time", type datetime}, {"suspected_infection_time", type datetime}, {"sepsis_time", type datetime}, {"baseline_time", type datetime}, {"first_beta_blocker_time", type datetime}, {"deceased", type datetime}, {"age", Int64.Type}, {"icu_hours", type number}}),
				    Group = Table.AddColumn(Typed, "Treatment group", each if [beta_blocker] then "Beta-blocker" else "No beta-blocker", type text),
				    // Days from the baseline (first vasopressor) to death, and to the first beta-blocker.
				    ToDeath = Table.AddColumn(Group, "Days to death", each
				        if [deceased] = null or [baseline_time] = null then null else Duration.TotalDays([deceased] - [baseline_time]), type number),
				    ToBeta = Table.AddColumn(ToDeath, "Hours to first beta-blocker", each
				        if [first_beta_blocker_time] = null or [baseline_time] = null then null
				        else Duration.TotalHours([first_beta_blocker_time] - [baseline_time]), type number),
				    Died = Table.AddColumn(ToBeta, "Died within 28 days", each if [died_within_28_days] = true then "Yes" else "No", type text),
				    Label = Table.AddColumn(Died, "Patient", each Text.End([patient_id], 8), type text)
				in
				    Label
